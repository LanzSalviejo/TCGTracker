<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivDetailCardImage"
            android:layout_width="220dp"
            android:layout_height="300dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvDetailCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvDetailCardVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#616161"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvDetailUsdPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TCG Market Price: Loading..."
            android:textSize="16sp"
            android:textColor="#00796B"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USD to CAD Exchange Rate (Live / Editable):"
            android:layout_marginTop="16dp" />

        <!-- User Input 2: Live Auto-Filled Exchange Rate + Manual Refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etExchangeRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Fetching live rate..."
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/btnRefreshRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Refresh"
                android:backgroundTint="#2196F3"
                />
        </LinearLayout>

        <!-- Shows whether rate is Live, Cached, or Offline Cache + date -->
        <TextView
            android:id="@+id/tvFxStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fetching live USD/CAD rate..."
            android:textSize="12sp"
            android:textColor="#616161"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity to Save:"
            android:layout_marginTop="12dp" />

        <!-- User Input 3: Quantity Owned -->
        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1"
            android:inputType="number" />

        <Button
            android:id="@+id/btnCalculateCAD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Calculate CAD Price"
            android:backgroundTint="#2196F3"
            />

        <!-- Computation Output -->
        <TextView
            android:id="@+id/tvCalculatedCadPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price in CAD: $0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnSaveToWatchlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save to Watchlist"
            android:backgroundTint="#2196F3"
            />

        <Button
            android:id="@+id/btnViewTcgPlayerSales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="View Last Sold History on TCGplayer"
            android:backgroundTint="#2196F3"
            />

    </LinearLayout>
</ScrollView>