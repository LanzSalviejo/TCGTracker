<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Watchlist"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWatchlistFxInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:text="Fetching live USD/CAD rate..."
        android:textSize="12sp"
        android:textColor="#616161" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyWatchlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No cards saved yet.\nSearch a card and tap Save to Watchlist."
        android:textAlignment="center"
        android:textSize="16sp"
        android:textColor="#757575"
        android:visibility="gone" />

    <!-- Saved Cards List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWatchlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Watchlist Total Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Watchlist Total"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 cards"
                    android:textSize="13sp"
                    android:textColor="#616161" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWatchlistTotalCad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$0.00 CAD"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1B7A3E" />

            <TextView
                android:id="@+id/tvWatchlistTotalMarketRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TCG Market Ref: $0.00 USD"
                android:textSize="12sp"
                android:textColor="#616161" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>